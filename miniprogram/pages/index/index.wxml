<view class="container">
  <view class="row between top">
    <view>
      <view class="brand">农餐馆<text class="brand-en">CAU FOOD GUIDE</text></view>
      <view class="brand-sub">中国农业大学 · {{canteenLabel}}</view>
    </view>
    <view class="row head-actions">
      <view class="points">积分 {{points}}</view>
      <view class="gear" bindtap="onConfig">⚙</view>
    </view>
  </view>

  <scroll-view scroll-x class="canteens" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{canteens}}"
      wx:key="id"
      class="canteen {{activeCanteen === item.id ? 'on' : ''}} {{item.status !== 'online' ? 'disabled' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCanteen"
    >
      <view class="canteen-name">{{item.name}}</view>
      <view class="canteen-state">{{item.status === 'online' ? '已上线' : '待录入'}}</view>
    </view>
  </scroll-view>

  <view class="hero card">
    <view class="hero-title">今天，也要<text class="hl">好好吃饭。</text></view>
    <view class="muted">主人，今天想吃点啥呢？{{canteenLabel}} · {{menu.dataDate}} 现场采集</view>
  </view>

  <view class="entry-actions">
    <view class="entry-action primary" bindtap="rollAndScroll">
      <view class="ea-icon">🎁</view>
      <view class="ea-copy">
        <view class="ea-title">盲盒随机</view>
        <view class="ea-sub">根据人流 · 时间</view>
      </view>
      <view class="ea-arrow">›</view>
    </view>
    <view class="entry-action" bindtap="scrollToMeal">
      <view class="ea-icon plain">📈</view>
      <view class="ea-copy">
        <view class="ea-title">今天怎么吃</view>
        <view class="ea-sub">根据饮食记录</view>
      </view>
      <view class="ea-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card error">
    <view class="title">加载失败</view>
    <view class="muted">{{error}}</view>
    <view class="muted">当前服务器：{{apiBase}}</view>
    <button class="btn btn-primary config-btn" bindtap="onConfig">设置服务器地址</button>
  </view>

  <block wx:else>
    <view class="row between section-head">
      <view>
        <view class="eyebrow">WINDOWS · 先出现</view>
        <view class="title">哪个窗口不排队</view>
      </view>
      <view class="link" bindtap="goQueue">排队雷达 ›</view>
    </view>

    <scroll-view scroll-x class="win-strip" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{windows}}"
        wx:key="id"
        class="win-card {{item.stateCls === 'low' ? 'calm' : ''}} {{item.stateCls === 'high' ? 'busy' : ''}}"
        data-id="{{item.id}}"
        bindtap="openWindow"
      >
        <view class="win-top">
          <view class="win-num">{{item.number}}</view>
          <view class="win-name">{{item.name}}</view>
        </view>
        <view class="row between win-state">
          <view class="state {{item.stateCls}}">{{item.state}}</view>
          <view class="muted">{{item.people}} 人</view>
        </view>
        <view class="muted win-age">{{item.age}}</view>
        <view class="win-actions">
          <view class="win-btn" catchtap="goQueue" data-id="{{item.id}}">排队</view>
          <view class="win-btn on" catchtap="openWindow" data-id="{{item.id}}">菜品</view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{!windows.length}}" class="muted empty-line">该食堂窗口暂未录入</view>

    <view class="card blindbox" id="blindbox">
      <view class="row between">
        <view>
          <view class="eyebrow">BLIND BOX · 选择困难救星</view>
          <view class="title">今天吃什么</view>
        </view>
        <view class="muted">从{{canteenLabel}}已录入菜品里抽</view>
      </view>

      <view class="box-stage {{boxRolling ? 'rolling' : ''}}">
        <block wx:if="{{boxDish}}">
          <view class="box-emoji">{{boxDish.emoji}}</view>
          <view class="box-name">{{boxDish.name}}</view>
          <view class="muted">{{boxDish.windowNumber}} 号 · {{boxDish.windowName}}</view>
          <view class="box-meta">{{boxDish.kcal}} kcal · 蛋白 {{boxDish.protein}}g<text wx:if="{{boxDish.rating}}"> · ★ {{boxDish.rating}}</text></view>
          <view class="row wrap box-tags">
            <view class="tag" wx:for="{{boxDish.tags}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="row box-actions">
            <button class="btn small" bindtap="drawBox">再抽一次</button>
            <button class="btn btn-primary small" data-id="{{boxDish.id}}" bindtap="openDish">去看看 ›</button>
          </view>
        </block>
        <block wx:else>
          <view class="box-emoji {{boxRolling ? 'shake' : ''}}">🎁</view>
          <view class="box-name">{{boxRolling ? '正在摇盲盒…' : '选择困难？交给一点好运气'}}</view>
          <view class="muted">避开最近吃过的，抽一道今天没吃过的</view>
          <button class="btn btn-primary box-draw" bindtap="drawBox" disabled="{{boxRolling}}">抽一个</button>
        </block>
      </view>
    </view>

    <view class="card" id="meal">
      <view class="row between">
        <view>
          <view class="eyebrow">SMART MEAL</view>
          <view class="title">今天怎么吃</view>
        </view>
        <view class="link" bindtap="reroll">换一餐</view>
      </view>
      <view class="muted recent-hint" wx:if="{{recentHint}}">{{recentHint}}</view>
      <scroll-view scroll-x class="goals">
        <view
          wx:for="{{goals}}"
          wx:key="key"
          class="goal {{goal === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onGoal"
        >{{item.label}}</view>
      </scroll-view>
      <view class="meal">
        <view class="meal-item" wx:for="{{meal}}" wx:key="id" bindtap="openDish" data-id="{{item.id}}">
          <view class="muted">{{item.windowNumber}} 号 · {{item.windowName}}</view>
          <view class="meal-name">{{item.name}}</view>
          <view class="muted">{{item.kcal}} kcal · 蛋白 {{item.proteinText}}g</view>
        </view>
        <view wx:if="{{!meal.length}}" class="muted">该食堂暂无可配餐的菜品</view>
      </view>
      <view class="row between meal-total">
        <view>
          <text class="muted">这一餐约 </text><text class="num">{{mealTotals.kcal}}</text>
          <text class="muted"> kcal · 蛋白 {{mealTotals.protein}}g · 碳排约 {{mealTotals.carbon}} kg</text>
        </view>
        <button class="btn btn-primary small" bindtap="addMeal">加入餐盘</button>
      </view>
    </view>

    <view class="card" wx:if="{{leaderboard.length}}">
      <view class="row between">
        <view>
          <view class="eyebrow">TOP RATED</view>
          <view class="title">好评榜</view>
        </view>
        <view class="link" bindtap="goMenu">全部菜单 ›</view>
      </view>
      <view class="rank-item" wx:for="{{leaderboard}}" wx:key="id" data-id="{{item.id}}" bindtap="openDish">
        <view class="rank-no">{{index + 1}}</view>
        <view class="grow">
          <view class="rank-name">{{item.name}}</view>
          <view class="muted">{{item.windowNumber}} 号窗口 · {{item.reviewCount}} 条点评</view>
        </view>
        <view class="rank-score">★ {{item.rating}}</view>
      </view>
    </view>

    <view class="card tray-card" wx:if="{{trayCount > 0}}">
      <view class="row between">
        <view>
          <view class="eyebrow">MY PLATE</view>
          <view class="title">今日餐盘</view>
        </view>
        <view class="link" bindtap="clearTray">清空</view>
      </view>
      <view class="row between tray-line">
        <view><text class="num">{{trayCount}}</text><text class="muted"> 道 · {{trayKcal}} kcal</text></view>
        <button class="btn small" bindtap="logTray">记下这一餐</button>
      </view>
    </view>

    <view class="card row between">
      <view>
        <view class="title">菜品与营养</view>
        <view class="muted">搜索、按营养筛选、按热量排序</view>
      </view>
      <button class="btn small" bindtap="goMenu">去菜单 ›</button>
    </view>
  </block>
</view>
