.top { margin: 8rpx 4rpx 22rpx; }
.brand { color: #173f35; font-size: 46rpx; font-weight: 700; letter-spacing: 6rpx; }
.brand-en { margin-left: 12rpx; color: #77837c; font-size: 16rpx; font-weight: 600; letter-spacing: 2rpx; }
.brand-sub { color: #77837c; font-size: 20rpx; margin-top: 2rpx; }
.gear {
  width: 68rpx; height: 68rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid #e0e5db; border-radius: 18rpx; background: #fffef9; color: #2c6651; font-size: 30rpx;
}

.hero { background: #173f35; border-color: #173f35; }
.hero-title { color: #ffffff; font-size: 52rpx; font-weight: 700; letter-spacing: -1rpx; }
.hl { color: #e3edb5; }
.hero .muted { color: rgba(255, 255, 255, .6); margin-top: 10rpx; }
.stats { margin-top: 26rpx; }
.stat { flex: 1; }
.hero .num { color: #e3edb5; }
.hero .muted { color: rgba(255, 255, 255, .55); }

/* 入口动作 */
.entry-actions { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.entry-action {
  flex: 1;
  display: flex; align-items: center; gap: 12rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #e0e5db; border-radius: 24rpx;
  background: #fffef9;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 45, .05);
}
.entry-action.primary { background: #173f35; border-color: #173f35; }
.ea-icon {
  width: 64rpx; height: 64rpx; flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; background: rgba(255, 255, 255, .14); font-size: 32rpx;
}
.ea-icon.plain { background: #e6eee5; }
.ea-copy { flex: 1; min-width: 0; }
.ea-title { color: #173f35; font-size: 26rpx; font-weight: 700; }
.entry-action.primary .ea-title { color: #ffffff; }
.ea-sub { margin-top: 4rpx; color: #98a29b; font-size: 19rpx; }
.entry-action.primary .ea-sub { color: rgba(255, 255, 255, .6); }
.ea-arrow { color: #a7b1a9; font-size: 32rpx; }
.entry-action.primary .ea-arrow { color: #e3edb5; }

/* 窗口条 */
.section-head { padding: 14rpx 4rpx 14rpx; }
.win-strip { white-space: nowrap; margin-bottom: 20rpx; }
.win-card {
  display: inline-block; vertical-align: top;
  width: 300rpx; margin-right: 14rpx; padding: 20rpx;
  border: 1rpx solid #e0e5db; border-radius: 24rpx;
  background: #fffef9;
}
.win-card.calm { border-color: #cddcc7; }
.win-card.busy { border-color: #efd0c4; }
.win-top { display: flex; align-items: center; gap: 12rpx; }
.win-num {
  width: 52rpx; height: 52rpx; flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid #e0e5db; border-radius: 14rpx; background: #f8f9f3;
  color: #607368; font-family: Georgia, serif; font-size: 24rpx;
}
.win-name {
  flex: 1; min-width: 0; overflow: hidden;
  color: #173f35; font-size: 24rpx; font-weight: 600;
  white-space: nowrap; text-overflow: ellipsis;
}
.win-state { margin-top: 14rpx; }
.win-age { margin-top: 8rpx; font-size: 18rpx; }
.win-actions { display: flex; gap: 10rpx; margin-top: 16rpx; }
.win-btn {
  flex: 1; height: 54rpx; line-height: 54rpx; text-align: center;
  border: 1rpx solid #e0e5db; border-radius: 14rpx;
  background: #f8f9f3; color: #5f7267; font-size: 20rpx;
}
.win-btn.on { background: #173f35; border-color: #173f35; color: #ffffff; }
.empty-line { padding: 10rpx 4rpx 26rpx; }

.tray-line { margin-top: 14rpx; }

.qitem { padding: 20rpx 0; border-bottom: 1rpx solid #eef1e9; }
.qitem:last-child { border-bottom: none; padding-bottom: 0; }
.qname { color: #173f35; font-size: 26rpx; font-weight: 600; }
.qmeta { margin-top: 6rpx; }
.qnum { color: #173f35; font-family: Georgia, serif; font-size: 38rpx; }

.goals { white-space: nowrap; margin-top: 16rpx; }
.goal {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 10rpx;
  border: 1rpx solid #e0e5db;
  border-radius: 999rpx;
  background: #f8f9f3;
  color: #77837c;
  font-size: 22rpx;
}
.goal.on { background: #173f35; border-color: #173f35; color: #ffffff; }

.meal { margin-top: 16rpx; }
.meal-item {
  padding: 18rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e0e5db;
  border-radius: 20rpx;
  background: #f8f9f3;
}
.meal-name { color: #173f35; font-size: 28rpx; font-weight: 600; margin: 4rpx 0; }
.meal-total { margin-top: 12rpx; padding-top: 16rpx; border-top: 1rpx dashed #e0e5db; }
.config-btn { margin-top: 18rpx; }

.head-actions .gear { margin-left: 12rpx; }
.points {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #e3edb5;
  color: #173f35;
  font-size: 20rpx;
  font-weight: 700;
}

.recent-hint { margin-top: 8rpx; color: #2c6651; font-size: 20rpx; }

.blindbox .box-stage {
  margin-top: 16rpx;
  padding: 26rpx 20rpx;
  border: 1rpx dashed #cfd8cc;
  border-radius: 22rpx;
  background: #f8f9f3;
  text-align: center;
}
.box-stage.rolling { background: #eef2e8; }
.box-emoji { font-size: 76rpx; line-height: 1.25; }
.box-emoji.shake { animation: boxshake .38s ease-in-out infinite; }
@keyframes boxshake {
  0%, 100% { transform: rotate(-7deg); }
  50% { transform: rotate(7deg) scale(1.08); }
}
.box-name { margin-top: 8rpx; color: #173f35; font-size: 32rpx; font-weight: 700; }
.box-meta { margin-top: 6rpx; color: #2c6651; font-size: 22rpx; }
.box-tags { justify-content: center; margin-top: 6rpx; }
.box-actions { justify-content: center; margin-top: 16rpx; }
.box-actions .btn { margin: 0 8rpx; }
.box-draw { margin-top: 16rpx; }
.rank-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #eef1e9; }
.rank-item:last-child { border-bottom: none; }
.rank-no { width: 40rpx; text-align: center; color: #a3b0a5; font-family: Georgia, serif; font-size: 30rpx; }
.rank-name { color: #173f35; font-size: 26rpx; font-weight: 600; }
.rank-score { color: #a87818; font-size: 22rpx; white-space: nowrap; }
