<view class="container">
  <view wx:if="{{loading}}" class="card muted">正在加载…</view>
  <view wx:elif="{{error}}" class="card error">
    <view class="title">加载失败</view>
    <view class="muted">{{error}}</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="muted">{{window.number}} 号窗口 · {{window.name}}</view>
      <view class="row between head">
        <view class="name">{{dish.name}}</view>
        <view class="row head-right">
          <view class="price">{{dish.priceText}}</view>
          <view class="heap {{fav ? 'on' : ''}}" bindtap="toggleFav">{{fav ? '♥ 已收藏' : '♡ 收藏'}}</view>
        </view>
      </view>
      <view class="row wrap">
        <view class="tag" wx:for="{{dish.labels}}" wx:key="*this">{{item}}</view>
        <view class="tag source">{{dish.source}}</view>
      </view>
      <view class="desc">{{dish.description}}</view>
    </view>

    <view class="card">
      <view class="eyebrow">NUTRITION</view>
      <view class="title">每 100 克</view>
      <view class="row per100">
        <view class="cell"><view class="cell-num">{{per100.kcal}}</view><view class="muted">kcal</view></view>
        <view class="cell"><view class="cell-num">{{per100.protein}}</view><view class="muted">蛋白 g</view></view>
        <view class="cell"><view class="cell-num">{{per100.fat}}</view><view class="muted">脂肪 g</view></view>
        <view class="cell"><view class="cell-num">{{per100.carbs}}</view><view class="muted">碳水 g</view></view>
        <view class="cell"><view class="cell-num">{{per100.fiber}}</view><view class="muted">纤维 g</view></view>
      </view>
      <view class="portion-title">选择食用份量</view>
      <view class="row portions">
        <view class="portion {{factor === 0.5 ? 'on' : ''}}" data-factor="0.5" bindtap="setFactor">半份</view>
        <view class="portion {{factor === 1 ? 'on' : ''}}" data-factor="1" bindtap="setFactor">标准份</view>
        <view class="portion {{factor === 1.5 ? 'on' : ''}}" data-factor="1.5" bindtap="setFactor">1.5 份</view>
      </view>
      <view class="portion-result">
        <text class="big">{{nut.kcal}}</text><text class="muted"> kcal · 约 {{nut.grams}}g · 蛋白 {{nut.protein}}g · 脂肪 {{nut.fat}}g · 碳排约 {{nut.carbon}} kg</text>
      </view>
      <button class="btn btn-primary add-tray" bindtap="addToTray">加入今日餐盘 · {{nut.kcal}} kcal</button>
    </view>

    <view class="card">
      <view class="row between">
        <view>
          <view class="eyebrow">LIVE QUEUE</view>
          <view class="title">这个窗口现在</view>
        </view>
        <view class="state {{queue ? queue.stateCls : 'none'}}">{{queue ? queue.state : '暂无数据'}}</view>
      </view>
      <view wx:if="{{queue}}" class="queue-line">
        <text class="qnum">{{queue.people}}</text><text class="muted"> 人 · 约 {{queue.waitMin}} 分钟 · {{queue.ageText}}更新</text>
      </view>
      <view wx:else class="muted queue-line">还没有人上报，去帮大家报一个？</view>
      <button class="btn small queue-btn" bindtap="goQueue">去排队雷达</button>
    </view>

    <view class="card">
      <view class="row between">
        <view>
          <view class="eyebrow">REVIEWS</view>
          <view class="title">大家怎么说</view>
        </view>
        <view class="score" wx:if="{{stats.reviewCount}}">{{stats.rating}} 分 · {{stats.reviewCount}} 条</view>
        <view class="muted" wx:else>暂无评分</view>
      </view>

      <view class="review" wx:for="{{reviews}}" wx:key="id">
        <view class="row between">
          <view class="review-author">{{item.author}}</view>
          <view class="stars">{{item.stars}}</view>
        </view>
        <view class="review-text" wx:if="{{item.text}}">{{item.text}}</view>
        <view class="row between review-foot">
          <view class="muted">{{item.time}}</view>
          <view class="review-like {{item.liked ? 'on' : ''}}" data-id="{{item.id}}" catchtap="like">👍 {{item.likes}}</view>
        </view>
      </view>
      <view wx:if="{{!reviews.length}}" class="muted review-empty">还没有人点评，来做第一个。</view>

      <view class="form">
        <view class="form-title">写点评</view>
        <view class="row stars-picker">
          <view
            wx:for="{{starList}}"
            wx:key="*this"
            class="star {{stars >= item ? 'on' : ''}}"
            data-n="{{item}}"
            bindtap="onStar"
          >★</view>
        </view>
        <textarea
          class="textarea"
          maxlength="200"
          placeholder="这道菜好吃吗？分量和价格怎么样，说两句。"
          value="{{text}}"
          bindinput="onText"
        ></textarea>
        <view class="row between form-foot">
          <input class="nickname" maxlength="20" placeholder="昵称（选填）" value="{{nickname}}" bindinput="onNick" />
          <button class="btn btn-primary small" bindtap="submit" disabled="{{submitting}}">发布点评</button>
        </view>
      </view>
    </view>
  </block>
</view>
